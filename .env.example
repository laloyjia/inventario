# Copia este archivo a .env (sin extensión .example) y rellena los valores.
# El archivo .env NO se sube al repositorio (ver .gitignore).

# Llave secreta para sesiones de Flask (genera una random larga)
PANOL_SECRET_KEY=cambiame_por_string_random_de_64_caracteres

# Token compartido para sincronización entre nodos (no se usa en cloud)
PANOL_SYNC_TOKEN=cambiame_por_otro_string_random_largo

# Identificador del nodo (en cloud déjalo en "admin_central")
PANOL_NODO=admin_central

# Base de datos
# En LOCAL: comenta DATABASE_URL para usar SQLite (instance/inventario.db)
# En CLOUD: Render/Railway lo definen automáticamente, no tocar
# DATABASE_URL=postgresql://usuario:pass@host:5432/dbname

# Forzar HTTPS (true en producción, false en local para no romper)
FORCE_HTTPS=false

# Modo debug — NUNCA true en producción
FLASK_DEBUG=false
